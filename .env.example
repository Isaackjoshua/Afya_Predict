# ---------------------------------------------------------------------------
# AFYA-PREDICT environment template. Copy to `.env` and fill in what you have.
# Every credential is OPTIONAL: adapters without credentials fall back to
# cached files or to the deterministic synthetic generator, and the pipeline
# keeps running with widened confidence intervals (see rule #1 / #7).
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- Storage -------------------------------------------------------------
# Leave DATABASE_URL empty to use the bundled SQLite store at DATA_DIR/afya.sqlite
DATABASE_URL=
REDIS_URL=
DATA_DIR=./data
ARTIFACT_DIR=./artifacts

# --- Region / grid -------------------------------------------------------
DEFAULT_REGION=tanzania
OFFLINE_MODE=false

# --- DHIS2 (health surveillance) ----------------------------------------
DHIS2_BASE_URL=
DHIS2_USERNAME=
DHIS2_PASSWORD=

# --- Copernicus Climate Data Store (ERA5) --------------------------------
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# --- CHIRPS rainfall -----------------------------------------------------
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0

# --- NASA Earthdata (MODIS NDVI via AppEEARS) ----------------------------
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Copernicus Data Space (Sentinel-5P) ---------------------------------
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Mobility (aggregated CDR drop directory) ----------------------------
CDR_DATA_DIR=./data/raw/cdr

# --- Notifications -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@afya-predict.org

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=120
